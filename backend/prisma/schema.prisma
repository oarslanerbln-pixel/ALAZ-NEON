generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  medications Medication[]
}

model Medication {
  id        String   @id @default(uuid())
  userId    String
  name      String   // Encrypted before save
  dosage    String?  // Encrypted before save
  frequency String?  // Encrypted before save
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}
