{
  "name": "alaz-neon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:scripts": "node --test scripts/rules-drift.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project alaz-neon-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-hurrem-e2e \"playwright test --project=kafe\"",
    "test:e2e:measure": "firebase emulators:exec --only auth,firestore --project demo-hurrem-e2e \"playwright test --project=measure\""
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/three": "^0.186.0",
    "firebase": "^12.17.1",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.27.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "jsqr": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
