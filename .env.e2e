# Uçtan uca testlerin (npm run test:e2e) yapılandırması — GİZLİ DEĞİL.
# "demo-" önekli proje kimliği yalnızca emulator'de vardır; gerçek bir
# Firebase projesine hiçbir istek gitmez.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hengame.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-hengame
VITE_FIREBASE_STORAGE_BUCKET=demo-hengame.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2e
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
