rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    /**
     * Isletme/personel yetkisi.
     *
     * Onceden bu yetki "e-posta/sifre ile giris yapmis olmak"
     * (sign_in_provider == 'password') demekti. Ama /register herkese acik
     * bir oyuncu kayit ekrani ve orada da e-posta/sifre hesabi aciliyor:
     * yani HERHANGI bir ziyaretci kayit olup mekan markasini degistirebilir,
     * butun odul kuponlarini okuyabilir ve istedigini "kullanildi"
     * isaretleyebilirdi. Giris YONTEMI bir rol degil.
     *
     * Yetki artik acik bir listeye bagli:
     *   staff/{uid} dokumani varsa o hesap personeldir.
     * Doküman hicbir istemciden yazilamiyor (asagidaki match blogu),
     * yalnizca Firebase Console'dan ya da Admin SDK ile olusturuluyor.
     *
     * Custom claim de kabul ediliyor: proje Blaze plana gecip Cloud
     * Functions ile claim atamaya basladiginda kurallari degistirmeye gerek
     * kalmadan o yola gecilebilir (claim, get() maliyeti de olmayan daha
     * ucuz yol).
     */
    function isStaff() {
      return isAuth() && (
        request.auth.token.get('staff', false) == true ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    // A write may touch these fields and nothing else.
    function touchesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function playerDoc(playerId) {
      return get(/databases/$(database)/documents/players/$(playerId)).data;
    }

    // Bu oturumun, bu odadaki o oyuncu kaydının sahibi mi.
    function actsAs(playerId, roomId) {
      return playerDoc(playerId).uid == request.auth.uid &&
        playerDoc(playerId).room_id == roomId;
    }

    /**
     * Oyuncunun oda dokümanına yazabildiği üç sıra/yarış hamlesi: bomba
     * paslama, buzzer ve overload savuşturma. Bunlar odada kalıyor çünkü
     * sonucun anında herkese yayılması gerekiyor; host üzerinden
     * aktarmak her hamleye TV gecikmesi eklerdi (docs/roadmap.md, 1.3).
     *
     * Eskiden yalnızca alan listesi ve oda durumu kontrol ediliyordu: odada
     * olmayan biri de bombayı istediğine atabiliyor, başkası adına buzzer'a
     * basabiliyordu. Her hamle artık yazanın kimliğine bağlı: yalnızca
     * sırası gelen ve bu odadaki oyuncu yazabilir.
     */

    // Bomba: yalnızca bombayı tutan oyuncu, odadaki birine paslar;
    // kullanılmış kelime listesi yalnızca büyüyebilir (arrayUnion).
    function isBombPass(roomId) {
      let d = request.resource.data;
      let oldWords = resource.data.get('used_words', []);
      let newWords = d.get('used_words', []);
      return resource.data.status == 'bomb_active' &&
        touchesOnly(['previous_bomb_target_player', 'bomb_target_player', 'used_words']) &&
        actsAs(resource.data.bomb_target_player, roomId) &&
        d.previous_bomb_target_player == resource.data.bomb_target_player &&
        playerDoc(d.bomb_target_player).room_id == roomId &&
        newWords.hasAll(oldWords) &&
        newWords.size() <= oldWords.size() + 1;
    }

    // Sensör: ilk basan turu kilitler — yalnızca kendi adına.
    function isSensorBuzz(roomId) {
      return resource.data.status == 'sensor_active' &&
        request.resource.data.status == 'sensor_buzzed' &&
        touchesOnly(['status', 'sensor_buzzer_player_id', 'sensor_buzzer_timestamp']) &&
        actsAs(request.resource.data.sensor_buzzer_player_id, roomId);
    }

    // Sensör: cevabı yalnızca buzzer'a basan oyuncu yazar.
    function isSensorAnswer(roomId) {
      return resource.data.status == 'sensor_buzzed' &&
        touchesOnly(['sensor_player_answer']) &&
        request.resource.data.sensor_player_answer is string &&
        request.resource.data.sensor_player_answer.size() <= 100 &&
        actsAs(resource.data.sensor_buzzer_player_id, roomId);
    }

    // Çark: sırası gelen oyuncu (wheel_spinner_id) çarkı bir kez çevirir.
    // Kural yoktu: telefondaki "çevir" düğmesi her seferinde reddediliyordu.
    // Sonucu çeviren telefon seçiyor; dilim aralığı ve tek çevirme sınırı
    // burada, sonucu sunucuya taşımak Cloud Function işi (karar D2).
    // Dilimler mekan ayarında (app_config), odada değil: üst sınır kaba.
    function isWheelSpin(roomId) {
      let d = request.resource.data;
      return resource.data.status == 'wheel_active' &&
        d.status == 'wheel_spinning' &&
        touchesOnly(['status', 'wheel_result_index']) &&
        resource.data.get('wheel_result_index', null) == null &&
        d.wheel_result_index is int &&
        d.wheel_result_index >= 0 &&
        d.wheel_result_index < 64 &&
        actsAs(resource.data.wheel_spinner_id, roomId);
    }

    // Overload: hedef oyuncu bombayı "passing" durumuna atar; sonraki hedefi
    // ve kısalan süreyi host seçer (HostOverloadDisplay). Kural eskiden
    // istemcinin yazmadığı overload_time_allowed'ı beyaz listeye almış,
    // yazdığı overload_last_target_id'yi almamıştı: her savuşturma sessizce
    // reddediliyordu.
    function isOverloadDeflect(roomId) {
      return resource.data.status == 'playing' &&
        touchesOnly(['overload_target_id', 'overload_last_target_id']) &&
        request.resource.data.overload_target_id == 'passing' &&
        request.resource.data.overload_last_target_id == resource.data.overload_target_id &&
        actsAs(resource.data.overload_target_id, roomId);
    }

    match /rooms/{roomId} {
      // Anyone can read the room data
      allow read: if true;

      // Oda yalnızca personel hesabıyla açılır (docs/roadmap.md, karar D1).
      // Eskiden her anonim oturum host olabiliyordu; ödül ve kalıcı puan
      // yazma yetkisi "odanın host'u" üzerinden aktığı için oda açmak
      // hepsinin kapısıydı. TV/tablet bir kez personel hesabıyla giriş yapar.
      allow create: if isStaff() && request.resource.data.host_uid == request.auth.uid;

      // Odayı host serbestçe günceller. Oyuncu yalnızca yukarıdaki üç
      // kimliğe bağlı sıra/yarış hamlesini yazabilir; echo oyu ve pulse
      // dokunuşu artık aşağıdaki `inputs` alt koleksiyonunda.
      allow update: if isAuth() && (
        resource.data.host_uid == request.auth.uid ||
        isBombPass(roomId) ||
        isSensorBuzz(roomId) ||
        isSensorAnswer(roomId) ||
        isOverloadDeflect(roomId) ||
        isWheelSpin(roomId)
      );

      // Only the host can delete the room.
      allow delete: if isAuth() && resource.data.host_uid == request.auth.uid;

      /**
       * Emoji tepkileri (src/hooks/useEmojiPulse.ts): telefon tek bir
       * `emojiPulse` dokümanının üzerine yazar, TV onu dinler.
       *
       * Bu alt koleksiyon için hiç kural yoktu — `match /rooms/{roomId}`
       * alt koleksiyonları kapsamaz, varsayılan ret her tepkiyi sessizce
       * düşürüyordu. Yazan, bu odadaki kendi oyuncu kaydını göstermek
       * zorunda: odada olmayan biri TV'ye bir şey basamaz.
       */
      /**
       * Oyuncu girişleri: echo oyu ve pulse dokunuşu (docs/roadmap.md, 1.3).
       *
       * Eskiden oda dokümanındaki echo_votes/pulse_clicks haritalarına
       * yazılıyordu: her oy odadaki her telefona bir okuma olarak yayılıyor
       * (30 kişilik bir tur ≈ 930 okuma), harita da başkasının oyunu ezecek
       * şekilde yazılabiliyordu. Artık her oyuncu yalnızca kendi kaydına,
       * host'un açtığı tur için bir kez yazar; kayıtları yalnızca host
       * dinler ve sonucu reveal anında odaya kendisi yazar.
       */
      match /inputs/{playerId} {
        function roomData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function isHostOfRoom() {
          return roomData().host_uid == request.auth.uid;
        }

        // Kayıt her tur yeniden yazılıyor; aynı tura ikinci yazma yok.
        function isFreshRound() {
          return resource == null || resource.data.round != request.resource.data.round;
        }

        function isEchoInput() {
          let d = request.resource.data;
          return roomData().status == 'echo_active' &&
            d.keys().hasOnly(['round', 'echo_vote']) &&
            d.echo_vote is string &&
            d.echo_vote != playerId &&
            playerDoc(d.echo_vote).room_id == roomId;
        }

        function isPulseInput() {
          let d = request.resource.data;
          return roomData().status == 'pulse_active' &&
            d.keys().hasOnly(['round', 'pulse_click']) &&
            d.pulse_click is number;
        }

        allow get: if isAuth() && (actsAs(playerId, roomId) || isHostOfRoom());
        allow list: if isAuth() && isHostOfRoom();

        // Unity: oyuncu bu turdaki toplam dokunuşunu yazar; toplam yalnızca
        // artabilir ve bir yazmada en fazla 30 artar (clientWrites.UNITY_MAX_STEP).
        // Eskiden dokunuşlar oda dokümanına increment ile yazılıyordu ve
        // bunun için kural yoktu: her dokunuş reddediliyordu.
        function isUnityInput() {
          let d = request.resource.data;
          let prev = (resource != null && resource.data.round == d.round)
            ? resource.data.get('unity_clicks', 0)
            : 0;
          return roomData().status == 'unity_active' &&
            d.keys().hasOnly(['round', 'unity_clicks']) &&
            d.unity_clicks is int &&
            d.unity_clicks >= prev &&
            d.unity_clicks <= prev + 30;
        }

        allow create, update: if isAuth() &&
          actsAs(playerId, roomId) &&
          request.resource.data.round == roomData().input_round &&
          ((isFreshRound() && (isEchoInput() || isPulseInput())) || isUnityInput());

        allow delete: if isAuth() && isHostOfRoom();
      }

      match /transient/{docId} {
        allow read: if true;

        function isEmojiPulse() {
          let data = request.resource.data;
          let player = get(/databases/$(database)/documents/players/$(data.player_id)).data;
          return docId == 'emojiPulse' &&
            data.keys().hasOnly(['emoji', 'timestamp', 'player_id']) &&
            data.emoji is string && data.emoji.size() > 0 && data.emoji.size() <= 16 &&
            data.timestamp is number &&
            player.uid == request.auth.uid &&
            player.room_id == roomId;
        }

        allow create, update: if isAuth() && isEmojiPulse();
        allow delete: if isAuth() &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.host_uid == request.auth.uid;
      }
    }

    match /players/{playerId} {
      // Anyone can see the players
      allow read: if true;
      
      /**
       * Odaya katılım (src/pages/player/PlayerJoin.tsx). Yalnızca uid
       * kontrol ediliyordu: oyuncu `total_score: 9999` ile katılabiliyordu
       * ve ödül kazananı total_score'a göre seçildiği için bu, ödül kuralı
       * ne kadar sıkı olursa olsun bedava kupon demekti. Katılım artık
       * PlayerJoin'in yazdığı şemaya, sıfır puana ve canlı bir odaya bağlı
       * (kapalı durumlar lib/roomCodes.ts'teki CLOSED_STATUSES ile aynı).
       */
      function isValidJoin() {
        let data = request.resource.data;
        return data.uid == request.auth.uid &&
          data.keys().hasOnly(['room_id', 'nickname', 'team_name', 'total_score', 'night_score', 'uid', 'created_at', 'expires_at']) &&
          data.total_score == 0 &&
          data.get('night_score', 0) == 0 &&
          data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 20 &&
          (data.get('team_name', null) == null ||
            (data.team_name is string && data.team_name.size() <= 20)) &&
          !(get(/databases/$(database)/documents/rooms/$(data.room_id)).data.status in ['closed', 'finished']);
      }

      allow create: if isAuth() && isValidJoin();

      // A player's own game counters (Kablo, Colors, Spectrum, Bar) are
      // updated via increment() directly from the player's device. These
      // fields don't affect core scoring (total_score), which only the host
      // writes. Without this rule, every mini-game tap was silently
      // permission-denied and scores were never persisted.
      // last_active is the heartbeat ping that prevents ghost-player targeting.
      // Anti-Cheat: Saniyede en fazla 30 tıklama (batch) veya 1 skor artışı yapılabilir.
      function isValidIncrement() {
        return (request.resource.data.get('kablo_score', 0) - resource.data.get('kablo_score', 0)) <= 1 &&
               (request.resource.data.get('bar_score', 0) - resource.data.get('bar_score', 0)) <= 1 &&
               (request.resource.data.get('colors_clicks', 0) - resource.data.get('colors_clicks', 0)) <= 30 &&
               (request.resource.data.get('spectrum_clicks', 0) - resource.data.get('spectrum_clicks', 0)) <= 30;
      }

      function isPlayerSelfUpdate() {
        return resource.data.uid == request.auth.uid &&
          touchesOnly(['kablo_score', 'colors_clicks', 'spectrum_clicks', 'bar_score', 'last_active']) &&
          isValidIncrement();
      }

      // Scores and lives are awarded by the host only. Letting a player write
      // their own document meant they could simply set total_score to whatever
      // they liked — and nothing in the app needs it: every write to a player
      // doc comes from the host (score updates, bomb lives, round resets),
      // while the player only ever creates their own doc on join.
      allow update: if isAuth() && (
        get(/databases/$(database)/documents/rooms/$(resource.data.room_id)).data.host_uid == request.auth.uid ||
        isPlayerSelfUpdate()
      );
      
      // Only host or the player themselves can delete the player profile
      allow delete: if isAuth() && (
        resource.data.uid == request.auth.uid || 
        get(/databases/$(database)/documents/rooms/$(resource.data.room_id)).data.host_uid == request.auth.uid
      );
    }

    /**
     * ALAZ League profili (src/hooks/useUserProfile.ts).
     *
     * Okuma: yalnızca sahibi. Profil telefon numarasını taşıyor ve okuma
     * herkese açıktı — kayıtlı bütün numaralar listelenebiliyordu (KVKK).
     * Uygulamada başkasının profilini okuyan bir ekran yok; liderlik
     * tablosu `players` koleksiyonundan besleniyor.
     *
     * Puan: kalıcı puanı ve ligi istemci kendisi yazamaz. Eskiden puanı
     * oyuncunun kendi cihazı increment() ile yazıyordu ve alan kısıtı
     * yoktu; konsoldan tek satırla lig tablosunun tepesine çıkılıyordu.
     * Puanı artık oyun sırasında personel hesaplı host ekranı yazıyor
     * (src/hooks/useLifetimeScoreSync.ts) ve yalnızca o alana dokunabiliyor.
     */
    match /users/{userId} {
      function isValidNickname() {
        return request.resource.data.get('nickname', '') is string &&
          request.resource.data.get('nickname', '').size() <= 20;
      }

      allow read: if isAuth() && request.auth.uid == userId;

      allow create: if isAuth() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['phone_number', 'nickname', 'total_lifetime_score', 'current_league', 'created_at', 'last_active']) &&
        request.resource.data.get('total_lifetime_score', 0) == 0 &&
        request.resource.data.get('current_league', 'BRONZE') == 'BRONZE' &&
        isValidNickname();

      allow update: if isAuth() && (
        (request.auth.uid == userId &&
          touchesOnly(['nickname', 'last_active']) &&
          isValidNickname()) ||
        (isStaff() &&
          touchesOnly(['total_lifetime_score']) &&
          request.resource.data.total_lifetime_score is number)
      );

      allow delete: if false;
    }

    /**
     * AYNA salon anketi (bkz. src/lib/aynaSalon.ts). Herkese açık `answers`
     * koleksiyonuna yazılsaydı her misafir kimin ne dediğini okuyabilirdi;
     * bu yüzden ayrı ve yalnızca host'a (TV) okunur bir koleksiyon.
     *
     * - Kimlik `<room_id>_<uid>`: misafir oda başına TEK kez yanıtlar;
     *   ikinci yazma bir güncellemedir ve reddedilir.
     * - Yazma yalnızca oda `ayna_survey` durumundayken: anket kapandıktan
     *   sonra sonucu kaydıracak geç cevap gelemez.
     * - `player_id` gerçekten bu hesabın o odadaki oyuncusu olmalı: odaya
     *   katılmamış biri anketi dolduramaz.
     * - `host_uid` odanın host'uyla aynı olmalı: okuma kuralı buna dayanıyor,
     *   host sorguyu `host_uid` filtresiyle atıyor.
     */
    match /ayna_survey/{docId} {
      allow read: if isAuth() && resource.data.host_uid == request.auth.uid;

      allow create: if isAuth() &&
        docId == request.resource.data.room_id + '_' + request.auth.uid &&
        request.resource.data.keys().hasOnly(['room_id', 'host_uid', 'player_id', 'answers', 'created_at', 'expires_at']) &&
        request.resource.data.answers is map &&
        request.resource.data.answers.size() <= 5 &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.room_id)).data.status == 'ayna_survey' &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.room_id)).data.host_uid == request.resource.data.host_uid &&
        get(/databases/$(database)/documents/players/$(request.resource.data.player_id)).data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/players/$(request.resource.data.player_id)).data.room_id == request.resource.data.room_id;

      allow update: if false;
      allow delete: if isAuth() && resource.data.host_uid == request.auth.uid;
    }

    match /answers/{answerId} {
      // Anyone can read answers (host needs to tally scores; players see their own review).
      allow read: if true;

      // A player may only submit an answer under their own player_id, and that
      // player document must actually belong to them (uid match). This was
      // previously unmatched by any rule, which meant Firestore's default-deny
      // silently rejected every answer submission in every game mode.
      allow create: if isAuth() &&
        request.resource.data.player_id is string &&
        get(/databases/$(database)/documents/players/$(request.resource.data.player_id)).data.uid == request.auth.uid;

      // Answers are never edited after submission, only cleared out by the host
      // between rounds/games.
      allow update: if false;
      allow delete: if isAuth() &&
        get(/databases/$(database)/documents/rooms/$(resource.data.room_id)).data.host_uid == request.auth.uid;
    }

    /**
     * Personel listesi. Dokumanin ICERIGI onemli degil, VARLIGI yetkiyi
     * veriyor (istege bagli olarak not/isim alanlari tutulabilir).
     *
     * Yazma hicbir istemciye acik degil: bu kural kendi kendine yetki
     * verilmesini engelleyen tek sey. Yeni personel Firebase Console'dan
     * staff/<uid> dokumani olusturularak ekleniyor (bkz. README).
     *
     * Okuma yalnizca kisinin KENDI dokumanina acik: arayuz "bu hesap
     * personel mi" sorusunu sorabilsin diye. Butun listeyi cekip personel
     * uid'lerini toplamak mumkun degil.
     */
    match /staff/{staffUid} {
      allow read: if isAuth() && request.auth.uid == staffUid;
      allow write: if false;
    }

    match /app_config/{docId} {
      // Aktif mekan markası (isim/logo/renk/özellik anahtarları) — herkes
      // okuyabilir (landing/login/host kurulumu oda açılmadan önce buna
      // bakıyor), ama yalnızca personel listesindeki hesap değiştirebilir.
      //
      // Bu kural bir kez zaten "yalnızca e-posta/şifre ile giriş yapmış
      // hesap" diye yazılmıştı; /register herkese açık olduğu için o,
      // pratikte "kayıt olan herkes" demekti. Yetkinin giriş yöntemine
      // değil açık bir listeye bağlanması tam olarak bu yüzden (isStaff).
      allow read: if true;
      allow write: if isStaff();
    }

    match /seasons/{seasonId} {
      // Sezonlar herkese acik okunur.
      allow read: if true;
      // Yazma onceden "gelistirme sirasinda simdilik" notuyla giris yapmis
      // HERKESE (anonim oyuncu oturumlari dahil) acikti; koleksiyon
      // uygulamada hic kullanilmiyor, yani bu yalnizca acik bir kapiydi.
      // Artik personel hesabina kilitli.
      allow write: if isStaff();
    }

    match /rewards/{rewardId} {
      // Önceden herhangi bir giriş yapmış oturum (anonim oyuncular DAHİL)
      // her ödülü okuyup "claimed" olarak işaretleyebiliyordu — bir oyuncu
      // tarayıcı konsolundan başka bir oyuncunun ödülünü kullanılmış
      // gösterebilir ya da tüm ödül koleksiyonunu listeleyip kodları
      // toplayabilirdi. Artık okuma sadece kendi ödülüne (PlayerRewards
      // ekranı) ya da işletme hesabına (RewardVerify doğrulama ekranı,
      // kodla arama yapıyor — resource.data.uid personelin kendi uid'i
      // değil) açık.
      allow read: if isAuth() &&
        (resource.data.uid == request.auth.uid || isStaff());

      // Ödül üretimi host tarafında (kazanan OYUNCULAR adına) oluyor —
      // host'un kendi kimliği kazananınkinden farklı, bu yüzden "sadece
      // kendi uid'in için yaz" kısıtı burada uygulanamıyor.
      //
      // Eskiden yalnızca status kontrol ediliyordu: herhangi bir anonim
      // oturum konsoldan kendine "available" bir kupon yazıp barda kodla
      // kullanabiliyordu. Artık yazan personel hesabı olmalı ve ödül, o
      // hesabın host'u olduğu bir odaya bağlı olmalı (karar D1, bkz.
      // docs/roadmap.md). Kalıcı çözüm Cloud Function (karar D2).
      allow create: if isStaff() &&
        request.resource.data.keys().hasOnly(['uid', 'nickname', 'type', 'title', 'description', 'status', 'code', 'earned_at', 'expires_at', 'room_id']) &&
        request.resource.data.status == 'available' &&
        request.resource.data.room_id is string &&
        get(/databases/$(database)/documents/rooms/$(request.resource.data.room_id)).data.host_uid == request.auth.uid;

      // Asıl güvenlik sınırı burada: "kullanıldı" işaretlemek yalnızca
      // işletme hesabına (barda doğrulama yapan personel) açık, ve yalnızca
      // status/claimed_at alanlarına dokunabiliyor — başka bir alanı
      // (uid, code, title...) değiştiremiyor.
      allow update: if isStaff() &&
        touchesOnly(['status', 'claimed_at']);

      allow delete: if false;
    }
  }
}
