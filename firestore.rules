rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // A write may touch these fields and nothing else.
    function touchesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Bomb mode: the player currently holding the bomb passes it on.
    function isBombPass() {
      return resource.data.status == 'bomb_active' &&
        touchesOnly(['previous_bomb_target_player', 'bomb_target_player', 'used_words']);
    }

    // Sensor mode: the first player to hit the buzzer claims the round.
    function isSensorBuzz() {
      return resource.data.status == 'sensor_active' &&
        request.resource.data.status == 'sensor_buzzed' &&
        touchesOnly(['status', 'sensor_buzzer_player_id', 'sensor_buzzer_timestamp']);
    }

    // Sensor mode: the player who buzzed types in their answer.
    function isSensorAnswer() {
      return resource.data.status == 'sensor_buzzed' &&
        touchesOnly(['sensor_player_answer']);
    }

    match /rooms/{roomId} {
      // Anyone can read the room data
      allow read: if true;

      // Only authenticated users can create a room. The creator must set themselves as the host.
      allow create: if isAuth() && request.resource.data.host_uid == request.auth.uid;

      // The host owns the room and may change anything in it. Players also have
      // to write a handful of specific fields as part of normal play — passing
      // the bomb, hitting the sensor buzzer, submitting the buzzer answer — and
      // the client does those writes directly from the player's device. A
      // host-only rule therefore silently breaks bomb and sensor mode entirely.
      // Each player-allowed write is pinned to its own field whitelist and to
      // the room status in which it actually makes sense.
      allow update: if isAuth() && (
        resource.data.host_uid == request.auth.uid ||
        isBombPass() ||
        isSensorBuzz() ||
        isSensorAnswer()
      );

      // Only the host can delete the room.
      allow delete: if isAuth() && resource.data.host_uid == request.auth.uid;
    }

    match /players/{playerId} {
      // Anyone can see the players
      allow read: if true;
      
      // Authenticated users can join a room (create their player profile)
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      
      // Scores and lives are awarded by the host only. Letting a player write
      // their own document meant they could simply set total_score to whatever
      // they liked — and nothing in the app needs it: every write to a player
      // doc comes from the host (score updates, bomb lives, round resets),
      // while the player only ever creates their own doc on join.
      allow update: if isAuth() &&
        get(/databases/$(database)/documents/rooms/$(resource.data.room_id)).data.host_uid == request.auth.uid;
      
      // Only host or the player themselves can delete the player profile
      allow delete: if isAuth() && (
        resource.data.uid == request.auth.uid || 
        get(/databases/$(database)/documents/rooms/$(resource.data.room_id)).data.host_uid == request.auth.uid
      );
    }

    // ALAZ League Rules
    match /users/{userId} {
      // Anyone can read profiles for the leaderboard
      allow read: if true;
      
      // Users can only create or update their own profile
      allow create, update: if isAuth() && request.auth.uid == userId;
      
      // Do not allow deletion of profiles directly
      allow delete: if false;
    }

    match /answers/{answerId} {
      // Anyone can read answers (host needs to tally scores; players see their own review).
      allow read: if true;

      // A player may only submit an answer under their own player_id, and that
      // player document must actually belong to them (uid match). This was
      // previously unmatched by any rule, which meant Firestore's default-deny
      // silently rejected every answer submission in every game mode.
      allow create: if isAuth() &&
        request.resource.data.player_id is string &&
        get(/databases/$(database)/documents/players/$(request.resource.data.player_id)).data.uid == request.auth.uid;

      // Answers are never edited after submission, only cleared out by the host
      // between rounds/games.
      allow update: if false;
      allow delete: if isAuth() &&
        get(/databases/$(database)/documents/rooms/$(resource.data.room_id)).data.host_uid == request.auth.uid;
    }

    match /seasons/{seasonId} {
      // Seasons are readable by everyone
      allow read: if true;
      // Writing seasons should only be done via admin/Cloud Functions (or manually by Host for now, so we can allow it for authenticated users during dev)
      allow write: if isAuth();
    }

    match /rewards/{rewardId} {
      // Authenticated users can read, create, and update rewards (to mark them as used)
      // In production, reward creation should probably be handled by a Cloud Function, but for this dev phase, client-side creation is allowed.
      allow read, create, update: if isAuth();
      allow delete: if false;
    }
  }
}
