DATABASE_URL="postgresql://user:password@localhost:5432/medisade"
JWT_SECRET="replace-with-a-long-random-string"
PORT=3001
# Set to "production" in real deployments — this makes the httpOnly auth
# cookie Secure (HTTPS-only). Leave unset for local http:// development,
# otherwise the browser will silently refuse to store the cookie.
NODE_ENV=development
# Comma-separated list of allowed CORS origins (the frontend's URL(s))
FRONTEND_URL="http://localhost:3000"
# Required for POST /documents (Rapor Tara AI özetleme). If unset, that route
# returns 503 instead of crashing the server — everything else still works.
ANTHROPIC_API_KEY="sk-ant-..."
