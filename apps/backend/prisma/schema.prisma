datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
model Document {
  id               String   @id @default(uuid())
  userId           String
  encryptedSummary String
  createdAt        DateTime @default(now())
}
model Medication {
  id        String   @id @default(uuid())
  userId    String
  name      String
  takenAt   DateTime?
  createdAt DateTime @default(now())
}
