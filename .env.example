# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# App Configuration
VITE_APP_TITLE=ALAZ NEON

# Hata izleme (opsiyonel) — sentry.io'da ücretsiz bir React projesi açıp
# DSN'i buraya yapıştırın. Boş bırakılırsa Sentry hiç initialize edilmez,
# uygulama önceki gibi çalışmaya devam eder.
VITE_SENTRY_DSN=

# Okunur stack trace için kaynak haritası yüklemesi (opsiyonel, YALNIZCA
# derleme ortamında — Vercel → Settings → Environment Variables). Bunlar
# VITE_ ile başlamaz ve tarayıcıya gitmez; token'ı repoya yazmayın.
# Üçü birden tanımlıysa derleme haritaları Sentry'ye yükleyip dist/'ten siler.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# App Check (opsiyonel, önerilir) — Firestore'a yalnızca bu uygulamadan gelen
# isteklerin ulaşmasını sağlar. Kurulum adımları: README → App Check.
# Boş bırakılırsa App Check kurulmaz, uygulama önceki gibi çalışır.
# reCAPTCHA v3 SITE anahtarı (herkese açık; gizli anahtar buraya YAZILMAZ,
# yalnızca Firebase konsoluna girilir).
VITE_RECAPTCHA_SITE_KEY=
# Konsolda kayıtlı sabit hata ayıklama jetonu (yalnızca CI/test ortamı).
# Geliştirmede boş bırakın: jeton otomatik üretilip tarayıcı konsoluna yazılır.
VITE_APPCHECK_DEBUG_TOKEN=
